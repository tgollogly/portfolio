# Copy to .dev.vars for local testing (never commit .dev.vars).
# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# Access challenge captcha (free): Cloudflare dashboard → Turnstile → Add site
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Required when ACCESS_CHALLENGE_ENABLED is true in server.js (signs tg_gate cookies)
CHALLENGE_SECRET=random_long_string_at_least_32_chars

# Pursuit question refresh — required for POST /api/pursuit-refresh (cron uses scheduled() only)
PURSUIT_REFRESH_SECRET=random_long_string_at_least_32_chars
# Optional: re-enable Gemini question generation (default is RSS/feeds only)
# PURSUIT_USE_AI=true

# Newry Fuel Watch — Slack buy alerts (Incoming Webhook URL)
# NEWRY_FUEL_SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Or reuse a generic webhook:
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Web Push VAPID keys — generate with: npx web-push generate-vapid-keys
# NEWRY_FUEL_VAPID_PUBLIC=BN...
# NEWRY_FUEL_VAPID_PRIVATE=...

# Bearer token for POST /api/newry-fuel/alert and GET /api/newry-fuel/debug
# NEWRY_FUEL_ALERT_SECRET=random_long_string_at_least_32_chars
